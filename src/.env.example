# Salin menjadi .env lalu isi. Jangan commit .env.
# Lokal native : postgres://postgres:PASSWORD_ANDA@localhost:5432/sigap
# Lokal docker : postgres://sigap:sigap@localhost:5433/sigap
# Neon (deploy): salin connection string dari dashboard Neon (sudah berisi sslmode=require)
DATABASE_URL=
PORT=3000
# String acak panjang, misalnya hasil: node -e "console.log(crypto.randomUUID())"
JWT_SECRET=
# Token rahasia untuk endpoint pembaruan (cron eksternal dan npm run perbarui)
CRON_TOKEN=
# Opsional. Kosongkan untuk memakai data titik panas historis dari seed (KNF02)
MAP_KEY=
